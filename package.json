{
  "name": "ttrpg-desktop-session-app",
  "version": "1.1.0",
  "private": true,
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "desktop": "electron .",
    "dist": "electron-builder",
    "relay": "node server/relay-server.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron-builder": "^24.13.3",
    "electron": "^31.0.0"
  },
  "build": {
    "appId": "com.openai.ttrpgcombat",
    "productName": "TTRPG Combat",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "server/**",
      "public/**"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
